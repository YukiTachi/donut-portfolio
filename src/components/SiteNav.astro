---
interface Props {
  /** [href, label] のリスト */
  links: [string, string][];
  ctaHref: string;
}

const { links, ctaHref } = Astro.props;
---

<nav class="rnav" id="rnav" aria-label="メインナビゲーション">
  <div class="rnav__brand">
    <span class="rnav__logo">y</span>
    <span class="rnav__name">Tachi</span>
  </div>
  <div class="rnav__links" id="rnav-links">
    {links.map(([href, label]) => (
      <a href={href}>{label}</a>
    ))}
  </div>
  <a href={ctaHref} class="rnav__cta">Contact <span>→</span></a>
  <button
    type="button"
    class="rnav__toggle"
    id="rnav-toggle"
    aria-label="メニューを開く"
    aria-expanded="false"
    aria-controls="rnav-links"
  >
    <span class="rnav__bar"></span>
    <span class="rnav__bar"></span>
    <span class="rnav__bar"></span>
  </button>
</nav>

<script is:inline>
  (function () {
    const nav = document.getElementById('rnav');
    if (!nav) return;

    // スクロール時の背景切り替え
    const onScroll = () => nav.classList.toggle('is-scrolled', window.scrollY > 40);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    // モバイル用ハンバーガーメニュー
    const toggle = document.getElementById('rnav-toggle');
    const panel = document.getElementById('rnav-links');
    if (!toggle || !panel) return;

    const setOpen = (open) => {
      nav.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      toggle.setAttribute('aria-label', open ? 'メニューを閉じる' : 'メニューを開く');
    };
    const isOpen = () => nav.classList.contains('is-open');

    toggle.addEventListener('click', () => setOpen(!isOpen()));
    panel.addEventListener('click', (e) => {
      if (e.target instanceof Element && e.target.closest('a')) setOpen(false);
    });
    document.addEventListener('click', (e) => {
      if (isOpen() && e.target instanceof Node && !nav.contains(e.target)) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) {
        setOpen(false);
        toggle.focus();
      }
    });
    window.matchMedia('(min-width: 769px)').addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });
  })();
</script>

<style>
  .rnav {
    position: fixed; top: 12px; left: 50%; transform: translateX(-50%);
    z-index: 100; transition: all .3s;
    background: rgba(244, 237, 224, 0.4);
    backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--c-rule); border-radius: 999px;
    padding: 10px 14px 10px 18px;
    display: flex; align-items: center; gap: 24px; font-size: 13px;
    max-width: min(900px, calc(100vw - 32px));
  }
  .rnav.is-scrolled {
    background: rgba(244, 237, 224, 0.85);
    box-shadow: 0 8px 24px rgba(34, 26, 63, 0.08);
  }
  .rnav__brand { display: flex; align-items: center; gap: 10px; }
  .rnav__logo {
    width: 22px; height: 22px; border-radius: 50%; background: var(--c-accent);
    display: inline-flex; align-items: center; justify-content: center;
    color: var(--c-cream); font-family: var(--ff-serif);
    font-size: 13px; font-weight: 600; font-style: italic;
  }
  .rnav__name { font-family: var(--ff-serif); font-size: 16px; font-weight: 500; }
  .rnav__links { display: flex; gap: 20px; }
  .rnav__links a { color: var(--c-ink); text-decoration: none; font-size: 13px; }
  .rnav__cta {
    background: var(--c-ink); color: var(--c-cream); padding: 8px 14px;
    border-radius: 999px; font-size: 12px; text-decoration: none;
    display: inline-flex; gap: 6px; align-items: center;
  }

  /* ハンバーガーボタン（モバイルのみ表示） */
  .rnav__toggle {
    display: none;
    width: 36px; height: 36px; padding: 0; flex-shrink: 0;
    border: 1px solid var(--c-rule); border-radius: 50%;
    background: transparent; color: var(--c-ink); cursor: pointer;
    flex-direction: column; align-items: center; justify-content: center; gap: 4px;
  }
  .rnav__toggle:focus-visible { outline: 2px solid var(--c-accent); outline-offset: 2px; }
  .rnav__bar {
    display: block; width: 14px; height: 1.5px; border-radius: 1px;
    background: currentColor; transition: transform .25s, opacity .2s;
  }
  .rnav.is-open .rnav__bar:nth-child(1) { transform: translateY(5.5px) rotate(45deg); }
  .rnav.is-open .rnav__bar:nth-child(2) { opacity: 0; }
  .rnav.is-open .rnav__bar:nth-child(3) { transform: translateY(-5.5px) rotate(-45deg); }

  @media (max-width: 768px) {
    .rnav { gap: 8px; padding: 8px 8px 8px 14px; font-size: 12px; }
    .rnav__brand { margin-right: 4px; }
    .rnav__toggle { display: inline-flex; }

    /* リンク群はピルの下に開くドロップダウンになる */
    .rnav__links {
      position: absolute; top: calc(100% + 8px); left: 0; right: 0;
      flex-direction: column; gap: 0; padding: 8px;
      background: rgba(244, 237, 224, 0.97);
      border: 1px solid var(--c-rule); border-radius: 20px;
      box-shadow: 0 12px 32px rgba(34, 26, 63, 0.12);
      opacity: 0; visibility: hidden; transform: translateY(-6px);
      transition: opacity .2s, transform .2s, visibility 0s linear .2s;
    }
    .rnav.is-open .rnav__links {
      opacity: 1; visibility: visible; transform: none;
      transition: opacity .2s, transform .2s, visibility 0s;
    }
    .rnav__links a {
      display: block; padding: 12px 14px; border-radius: 12px; font-size: 15px;
    }
    .rnav__links a:active { background: rgba(34, 26, 63, 0.06); }
  }

  @media (prefers-reduced-motion: reduce) {
    .rnav__links, .rnav__bar { transition: none; }
  }
</style>
